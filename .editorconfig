root = true

[*.cs]
# Keep imports outside file-scoped namespaces, ordered and free of unused directives.
csharp_using_directive_placement = outside_namespace
csharp_style_namespace_declarations = file_scoped
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0005.severity = warning

# Omit redundant instance qualification to match the repository style.
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false
dotnet_diagnostic.IDE0003.severity = warning

# Name private constants in PascalCase and other private fields in _camelCase.
dotnet_naming_rule.private_constants.symbols = private_constants
dotnet_naming_rule.private_constants.style = pascal_case
dotnet_naming_rule.private_constants.severity = warning
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel_case
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_diagnostic.IDE1006.severity = warning

# SA1101 conflicts with the repository rule to omit this qualification.
dotnet_diagnostic.SA1101.severity = none
# SA1309 conflicts with the underscore prefix for private fields.
dotnet_diagnostic.SA1309.severity = none
# SA1633 requires file headers, which the repository does not use.
dotnet_diagnostic.SA1633.severity = none
# SA1600 requires documentation on elements where comments are optional.
dotnet_diagnostic.SA1600.severity = none
# SA1601 requires documentation on partial elements where comments are optional.
dotnet_diagnostic.SA1601.severity = none
# SA1602 requires documentation on enumeration items where comments are optional.
dotnet_diagnostic.SA1602.severity = none
