<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Soriseom.App.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Viewbox>
            <Grid x:Name="Island" Width="360" Height="80">
                <SystemBackdropElement
                    x:Name="IslandBackdrop"
                    Width="80"
                    HorizontalAlignment="Center"
                    CornerRadius="40" />
                <Grid
                    x:Name="IslandForeground"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="40">
                    <Border
                        x:Name="SolidFallback"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        Visibility="Collapsed" />
                    <Grid x:Name="ContentRow" Padding="11,11,19,11" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="56" Height="56">
                            <Border
                                x:Name="NoteArt"
                                Width="56"
                                Height="56"
                                CornerRadius="12"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xEC4F;" FontSize="24" />
                            </Border>
                            <Border
                                x:Name="AlbumArt"
                                Width="56"
                                Height="56"
                                CornerRadius="12"
                                Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="AlbumArtBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TitleText"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                x:Name="ArtistText"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
