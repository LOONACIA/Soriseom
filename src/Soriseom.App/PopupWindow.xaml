<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Soriseom.App.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="12" ColumnSpacing="12" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="56" Height="56">
            <Border
                x:Name="NoteArt"
                Width="56"
                Height="56"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <FontIcon Glyph="&#xEC4F;" FontSize="24" />
            </Border>
            <Border
                x:Name="AlbumArt"
                Width="56"
                Height="56"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Visibility="Collapsed">
                <Border.Background>
                    <ImageBrush x:Name="AlbumArtBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                </Border.Background>
            </Border>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock
                x:Name="TitleText"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
            <TextBlock
                x:Name="ArtistText"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="NoWrap"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
        </StackPanel>
    </Grid>
</Window>
