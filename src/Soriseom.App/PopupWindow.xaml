<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Soriseom.App.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="PopupRimBrush" Color="#FF383838" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="PopupRimBrush" Color="#FFE0E0E0" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="PopupRimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Viewbox>
            <Grid x:Name="Island" Width="360" Height="80">
                <Grid x:Name="IslandSurface" Width="80" HorizontalAlignment="Center">
                    <SystemBackdropElement x:Name="IslandBackdrop" Margin="1" CornerRadius="39" />
                    <Border
                        x:Name="SolidFallback"
                        Margin="1"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        CornerRadius="39"
                        Visibility="Collapsed" />
                    <Border
                        BorderBrush="{ThemeResource PopupRimBrush}"
                        BorderThickness="2"
                        CornerRadius="40" />
                </Grid>
                <Grid x:Name="IslandForeground">
                    <Grid x:Name="ContentRow" Padding="12,12,20,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="56" Height="56">
                            <Border
                                x:Name="NoteArt"
                                Width="56"
                                Height="56"
                                CornerRadius="12"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xEC4F;" FontSize="24" />
                            </Border>
                            <Border
                                x:Name="AlbumArt"
                                Width="56"
                                Height="56"
                                CornerRadius="12"
                                Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="AlbumArtBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TitleText"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                x:Name="ArtistText"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
