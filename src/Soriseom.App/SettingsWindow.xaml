<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Soriseom.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Soriseom.App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer x:Name="ContentRoot">
        <StackPanel Padding="24" Spacing="8">
            <StackPanel.Resources>
                <Style x:Key="SettingsCardStyle" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                    <Setter Property="Padding" Value="16" />
                </Style>
            </StackPanel.Resources>
            <TextBlock
                x:Uid="SettingsHeader"
                AutomationProperties.AutomationId="SettingsHeader"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,0,0,12" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Slider
                    x:Uid="DisplaySecondsSlider"
                    Minimum="{x:Bind ViewModel.MinDisplaySeconds}"
                    Maximum="{x:Bind ViewModel.MaxDisplaySeconds}"
                    StepFrequency="1"
                    TickFrequency="1"
                    TickPlacement="Outside"
                    SnapsTo="StepValues"
                    Value="{x:Bind ViewModel.DisplaySeconds, Mode=TwoWay}" />
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid MinHeight="40" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PositionLabel"
                        x:Uid="PositionLabel"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                    <ComboBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.LabeledBy="{x:Bind PositionLabel}"
                        SelectedIndex="{x:Bind ViewModel.PositionIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="PositionTopLeft" />
                        <ComboBoxItem x:Uid="PositionTopCenter" />
                        <ComboBoxItem x:Uid="PositionTopRight" />
                        <ComboBoxItem x:Uid="PositionBottomLeft" />
                        <ComboBoxItem x:Uid="PositionBottomCenter" />
                        <ComboBoxItem x:Uid="PositionBottomRight" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Slider
                    x:Uid="PopupSizeSlider"
                    AutomationProperties.AutomationId="PopupSizeSlider"
                    Minimum="{x:Bind ViewModel.MinPopupSizePercent}"
                    Maximum="{x:Bind ViewModel.MaxPopupSizePercent}"
                    StepFrequency="5"
                    TickFrequency="5"
                    TickPlacement="Outside"
                    SnapsTo="StepValues"
                    Value="{x:Bind ViewModel.PopupSizePercent, Mode=TwoWay}" />
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="HideWhenFullscreenLabel"
                        x:Uid="HideWhenFullscreenLabel"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.LabeledBy="{x:Bind HideWhenFullscreenLabel}"
                        IsOn="{x:Bind ViewModel.HideWhenFullscreen, Mode=TwoWay}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="LaunchAtStartupLabel"
                            x:Uid="LaunchAtStartupLabel"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            AutomationProperties.AutomationId="LaunchAtStartupToggle"
                            AutomationProperties.LabeledBy="{x:Bind LaunchAtStartupLabel}"
                            IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanChangeLaunchAtStartup, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        x:Uid="LaunchAtStartupNotice"
                        AutomationProperties.AutomationId="LaunchAtStartupNotice"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowStartupNotice, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid MinHeight="40" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ThemeLabel"
                        x:Uid="ThemeLabel"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                    <ComboBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ThemeComboBox"
                        AutomationProperties.LabeledBy="{x:Bind ThemeLabel}"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="ThemeSystem" AutomationProperties.AutomationId="ThemeSystem" />
                        <ComboBoxItem x:Uid="ThemeLight" AutomationProperties.AutomationId="ThemeLight" />
                        <ComboBoxItem x:Uid="ThemeDark" AutomationProperties.AutomationId="ThemeDark" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <Grid MinHeight="40" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="LanguageLabel"
                            x:Uid="LanguageLabel"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="LanguageComboBox"
                            AutomationProperties.LabeledBy="{x:Bind LanguageLabel}"
                            SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="LanguageSystem" AutomationProperties.AutomationId="LanguageSystem" />
                            <ComboBoxItem x:Uid="LanguageKorean" AutomationProperties.AutomationId="LanguageKorean" />
                            <ComboBoxItem x:Uid="LanguageEnglish" AutomationProperties.AutomationId="LanguageEnglish" />
                        </ComboBox>
                    </Grid>
                    <TextBlock
                        x:Uid="LanguageRestartNotice"
                        AutomationProperties.AutomationId="LanguageRestartNotice"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.ShowLanguageRestartNotice, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <TextBlock
                x:Uid="AppsHeader"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Margin="0,16,0,0" />
            <TextBlock
                x:Uid="AppsDescription"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Apps}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:AppToggleViewModel">
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind DisplayName}"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    MinWidth="0"
                                    AutomationProperties.AutomationId="{x:Bind AppId}"
                                    AutomationProperties.Name="{x:Bind DisplayName}"
                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Window>
